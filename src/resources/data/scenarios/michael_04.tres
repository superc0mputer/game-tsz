[gd_resource type="Resource" script_class="ScenarioData" load_steps=9 format=3]

[ext_resource type="Script" path="res://src/resources/ScenarioData.gd" id="1_scenario"]
[ext_resource type="Script" path="res://src/resources/ChoiceData.gd" id="2_choice"]
[ext_resource type="Script" path="res://src/resources/ValueDelta.gd" id="3_delta"]
[ext_resource type="Resource" path="res://src/resources/data/characters/michael.tres" id="4_character"]

[sub_resource type="Resource" id="delta_a"]
script = ExtResource("3_delta")
selbststaendigkeit = 0
sicherheit = -2
verbundenheit = 0
entlastung = 1

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2_choice")
label = "Ich öffne einfach den Link aus der Mail."
outcome_text = "Die Nachricht war gefälscht und führte auf eine Seite, die persönliche Daten abfragen wollte."
delta = SubResource("delta_a")

[sub_resource type="Resource" id="delta_b"]
script = ExtResource("3_delta")
selbststaendigkeit = 0
sicherheit = 1
verbundenheit = 0
entlastung = -1

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2_choice")
label = "Ich prüfe die Sendung lieber über die offizielle Sendungsverfolgung."
outcome_text = "Dort findest du den echten Abholort. Die Mail gehörte nicht zu deiner Sendung und war ein Versuch, deine persönlichen Daten abzugreifen."
delta = SubResource("delta_b")

[resource]
script = ExtResource("1_scenario")
id = &"michael_04"
character = ExtResource("4_character")
title = "Paket liegt zur Abholung bereit"
body_text = "Sie haben eine Mail bekommen, dass Ihr Paket zur Abholung bereitliegt? Wenn Sie möchten, können wir kurz schauen, ob die Sendungsnummer zu Ihrem Paket passt."
channel = 0
sender_label = ""
choice_a = SubResource("choice_a")
choice_b = SubResource("choice_b")
follows = &""
