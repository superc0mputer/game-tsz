[gd_resource type="Resource" script_class="ScenarioData" load_steps=9 format=3]

[ext_resource type="Script" path="res://src/resources/ScenarioData.gd" id="1_scenario"]
[ext_resource type="Script" path="res://src/resources/ChoiceData.gd" id="2_choice"]
[ext_resource type="Script" path="res://src/resources/ValueDelta.gd" id="3_delta"]
[ext_resource type="Resource" path="res://src/resources/data/characters/gerhard.tres" id="4_character"]

[sub_resource type="Resource" id="delta_a"]
script = ExtResource("3_delta")
selbststaendigkeit = 1
sicherheit = -2
verbundenheit = 0
entlastung = 0

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2_choice")
label = "Mach das Ziel noch voll."
outcome_text = "Gerhard zieht die Einheit durch. Die App kennt aber weder seine Beschwerden noch seine individuelle Belastungsgrenze – ein höheres Tagesziel ist nicht automatisch sinnvoll."
delta = SubResource("delta_a")

[sub_resource type="Resource" id="delta_b"]
script = ExtResource("3_delta")
selbststaendigkeit = 1
sicherheit = 1
verbundenheit = 0
entlastung = 0

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2_choice")
label = "Für heute reicht es, hör lieber auf deinen Körper."
outcome_text = "Gerhard beendet das Training und beobachtet, wie sich die Beschwerden entwickeln. Wenn sie anhalten oder stärker werden, lässt er sie fachlich abklären."
delta = SubResource("delta_b")

[resource]
script = ExtResource("1_scenario")
id = &"gerhard_05"
character = ExtResource("4_character")
title = "Die Bewegungs-App"
body_text = "Ich hab mir so eine Bewegungs-App eingerichtet. Die setzt mir jeden Tag ein Ziel und heute meint sie, ich könnte noch ein bisschen mehr machen. Nach den Übungen tut mir aber das Knie deutlich mehr weh als sonst. Was meinst du – noch fertig machen oder für heute Schluss?"
channel = 0
sender_label = ""
choice_a = SubResource("choice_a")
choice_b = SubResource("choice_b")
follows = &""
