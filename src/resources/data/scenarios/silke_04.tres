[gd_resource type="Resource" script_class="ScenarioData" load_steps=9 format=3]

[ext_resource type="Script" path="res://src/resources/ScenarioData.gd" id="1_scenario"]
[ext_resource type="Script" path="res://src/resources/ChoiceData.gd" id="2_choice"]
[ext_resource type="Script" path="res://src/resources/ValueDelta.gd" id="3_delta"]
[ext_resource type="Resource" path="res://src/resources/data/characters/silke.tres" id="4_character"]

[sub_resource type="Resource" id="delta_a"]
script = ExtResource("3_delta")
selbststaendigkeit = -1
sicherheit = 0
verbundenheit = 1
entlastung = 0

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2_choice")
label = "Ja, bleib beim Gespräch dabei."
outcome_text = "Silke kann bei technischen Problemen helfen und fühlt sich einbezogen. Gleichzeitig übernimmt sie im Gespräch schnell das Wort."
delta = SubResource("delta_a")

[sub_resource type="Resource" id="delta_b"]
script = ExtResource("3_delta")
selbststaendigkeit = 1
sicherheit = 0
verbundenheit = -1
entlastung = 0

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2_choice")
label = "Hilf mir beim Einrichten, aber das Gespräch möchte ich allein führen."
outcome_text = "Silke hilft beim Start der Videosprechstunde und lässt dich danach allein mit der Ärztin sprechen. Du entscheidest selbst, was du besprechen möchtest."
delta = SubResource("delta_b")

[resource]
script = ExtResource("1_scenario")
id = &"silke_04"
character = ExtResource("4_character")
title = "Unterstützung bei der virtuellen Sprechstunde"
body_text = "Wenn du möchtest, setze ich mich bei der Videosprechstunde mit der Ärztin einfach daneben. Dann kann ich erklären, wenn irgendwas mit der Technik nicht klappt – und vielleicht fällt mir auch noch etwas ein, was du der Ärztin sagen solltest."
channel = 0
sender_label = ""
choice_a = SubResource("choice_a")
choice_b = SubResource("choice_b")
follows = &""
