[gd_resource type="Resource" script_class="ScenarioData" load_steps=9 format=3]

[ext_resource type="Script" path="res://src/resources/ScenarioData.gd" id="1_scenario"]
[ext_resource type="Script" path="res://src/resources/ChoiceData.gd" id="2_choice"]
[ext_resource type="Script" path="res://src/resources/ValueDelta.gd" id="3_delta"]
[ext_resource type="Resource" path="res://src/resources/data/characters/gerhard.tres" id="4_character"]

[sub_resource type="Resource" id="delta_a"]
script = ExtResource("3_delta")
selbststaendigkeit = 0
sicherheit = -1
verbundenheit = 0
entlastung = 1

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2_choice")
label = "Das ist doch praktisch, dann findest du die Passwörter wenigstens immer."
outcome_text = "Solange das Handy bei Gerhard ist, funktioniert das bequem. Geht es aber verloren oder wird gestohlen, liegen Handy und Zugangsdaten direkt zusammen – und jemand könnte mehrere Konten auf einmal ausprobieren."
delta = SubResource("delta_a")

[sub_resource type="Resource" id="delta_b"]
script = ExtResource("3_delta")
selbststaendigkeit = 0
sicherheit = 1
verbundenheit = 0
entlastung = -1

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2_choice")
label = "Ich würde den Zettel nicht direkt beim Handy aufbewahren."
outcome_text = "Gerhard trennt Handy und Passwörter voneinander. Das macht den Zugriff im Alltag etwas umständlicher, verhindert aber, dass bei einem Verlust gleich beides zusammen in fremde Hände gerät."
delta = SubResource("delta_b")

[resource]
script = ExtResource("1_scenario")
id = &"gerhard_07"
character = ExtResource("4_character")
title = "Passwörter in der Handyhülle"
body_text = "Ich bin bei diesen ganzen Internetseiten ja vorsichtig. Deshalb schreibe ich meine Passwörter lieber auf einen Zettel, statt sie irgendwo digital zu speichern. Den Zettel habe ich hier in der Handyhülle – dann habe ich ihn immer dabei."
channel = 0
sender_label = ""
choice_a = SubResource("choice_a")
choice_b = SubResource("choice_b")
follows = &""
