[gd_resource type="Resource" script_class="ScenarioData" load_steps=9 format=3]

[ext_resource type="Script" path="res://src/resources/ScenarioData.gd" id="1_scenario"]
[ext_resource type="Script" path="res://src/resources/ChoiceData.gd" id="2_choice"]
[ext_resource type="Script" path="res://src/resources/ValueDelta.gd" id="3_delta"]
[ext_resource type="Resource" path="res://src/resources/data/characters/noah.tres" id="4_character"]

[sub_resource type="Resource" id="delta_a"]
script = ExtResource("3_delta")
selbststaendigkeit = 1
sicherheit = 1
verbundenheit = 0
entlastung = -1

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2_choice")
label = "Als erste Orientierung okay, aber ich lasse das lieber fachlich abklären."
outcome_text = "Die KI hilft dir dabei, das Problem etwas einzuordnen. Ob die Erklärung wirklich passt, klärst du aber mit einer Fachperson."
delta = SubResource("delta_a")

[sub_resource type="Resource" id="delta_b"]
script = ExtResource("3_delta")
selbststaendigkeit = 0
sicherheit = -2
verbundenheit = 0
entlastung = 1

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2_choice")
label = "Dann probiere ich das erst mal so."
outcome_text = "Der Vorschlag klingt nachvollziehbar, berücksichtigt aber nur die Informationen, die Noah eingegeben hat. Eine KI kann überzeugend antworten, ohne beurteilen zu können, was tatsächlich hinter den Beschwerden steckt."
delta = SubResource("delta_b")

[resource]
script = ExtResource("1_scenario")
id = &"noah_05"
character = ExtResource("4_character")
title = "Ich hab mal die KI gefragt"
body_text = "Du hast doch erzählt, dass dir das Knie seit ein paar Tagen wehtut. Ich hab das gerade mal in die KI eingegeben. Die sagt, das klingt wahrscheinlich nach Überlastung und du sollst es ein paar Tage schonen. Klingt doch eigentlich ganz vernünftig, oder?"
channel = 0
sender_label = ""
choice_a = SubResource("choice_a")
choice_b = SubResource("choice_b")
follows = &""
