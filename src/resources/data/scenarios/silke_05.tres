[gd_resource type="Resource" script_class="ScenarioData" load_steps=9 format=3]

[ext_resource type="Script" path="res://src/resources/ScenarioData.gd" id="1_scenario"]
[ext_resource type="Script" path="res://src/resources/ChoiceData.gd" id="2_choice"]
[ext_resource type="Script" path="res://src/resources/ValueDelta.gd" id="3_delta"]
[ext_resource type="Resource" path="res://src/resources/data/characters/silke.tres" id="4_character"]

[sub_resource type="Resource" id="delta_a"]
script = ExtResource("3_delta")
selbststaendigkeit = 1
sicherheit = 1
verbundenheit = 0
entlastung = -1

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2_choice")
label = "Lass uns lieber schauen, ob es eine offizielle Möglichkeit gibt, dich zu bevollmächtigen."
outcome_text = "Ihr nutzt eine vorgesehene Vertretungs- oder Unterstützungsfunktion. Silke kann helfen, ohne dass du dein persönliches Passwort weitergeben musst."
delta = SubResource("delta_a")

[sub_resource type="Resource" id="delta_b"]
script = ExtResource("3_delta")
selbststaendigkeit = 0
sicherheit = -1
verbundenheit = 1
entlastung = 1

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2_choice")
label = "Okay, dann hast du meine Zugangsdaten."
outcome_text = "Silke kann schnell helfen, hat damit aber auch Zugang zu sehr persönlichen Gesundheitsdaten und kann in deinem Namen auf das Konto zugreifen."
delta = SubResource("delta_b")

[resource]
script = ExtResource("1_scenario")
id = &"silke_05"
character = ExtResource("4_character")
title = "Zugriff auf die Patientenakte"
body_text = "Wenn du möchtest, kann ich dir bei der Patientenakte helfen. Gib mir einfach dein Passwort, dann kann ich nachsehen, wenn du mal nicht weiterkommst."
channel = 0
sender_label = ""
choice_a = SubResource("choice_a")
choice_b = SubResource("choice_b")
follows = &""
