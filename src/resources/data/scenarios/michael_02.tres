[sub_resource type="Resource" id="delta_b"]
script = ExtResource("3_delta")
selbststaendigkeit = 0
sicherheit = 1
verbundenheit = 0
entlastung = -1

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2_choice")
label = "Nein, ich möchte Pakete lieber persönlich annehmen."
outcome_text = "Die Übergabe ist sicherer, dafür musst du häufiger zuhause sein oder zur Abholung gehen."
delta = SubResource("delta_b")

[resource]
script = ExtResource("1_scenario")
id = &"michael_02"
character = ExtResource("4_character")
title = "Zustellwunsch in der App"
body_text = "Sie können in der App einstellen, dass Pakete künftig automatisch vor der Haustür abgelegt werden. Dann müssen Sie nicht mehr zuhause sein. Wollen Sie das machen?"
channel = 0
