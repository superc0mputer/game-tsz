[ext_resource type="Script" path="res://src/resources/ValueDelta.gd" id="3_delta"]
[ext_resource type="Resource" path="res://src/resources/data/characters/michael.tres" id="4_character"]

[sub_resource type="Resource" id="delta_a"]
script = ExtResource("3_delta")
selbststaendigkeit = 0
sicherheit = -1
verbundenheit = 0
entlastung = 1

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2_choice")
label = "Ja, das wäre praktisch."
outcome_text = "Pakete werden künftig auch bei Abwesenheit zugestellt. Dafür liegen sie zeitweise unbeaufsichtigt."
