[gd_resource type="Resource" script_class="ScenarioData" load_steps=9 format=3]

[ext_resource type="Script" path="res://src/resources/ScenarioData.gd" id="1_scenario"]
[ext_resource type="Script" path="res://src/resources/ChoiceData.gd" id="2_choice"]
[ext_resource type="Script" path="res://src/resources/ValueDelta.gd" id="3_delta"]
[ext_resource type="Resource" path="res://src/resources/data/characters/linh.tres" id="4_character"]

[sub_resource type="Resource" id="delta_a"]
script = ExtResource("3_delta")
selbststaendigkeit = 1
sicherheit = 0
verbundenheit = 0
entlastung = 1

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2_choice")
label = "Ja, zeigen Sie mir, wie ich das selbst machen kann."
outcome_text = "Die Einrichtung dauert etwas, danach kannst du Überweisungen und Kontostand selbst von zu Hause aus erledigen und im Notfall deine Karten schnell sperren lassen."
delta = SubResource("delta_a")

[sub_resource type="Resource" id="delta_b"]
script = ExtResource("3_delta")
selbststaendigkeit = 0
sicherheit = 0
verbundenheit = 1
entlastung = -1

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2_choice")
label = "Nein, ich komme lieber weiterhin in die Filiale."
outcome_text = "Du bleibst bei deinem vertrauten Weg, hast bei Bankgeschäften persönlichen Kontakt und kannst Fragen schnell klären. Dafür bist du an Öffnungszeiten und Wege gebunden."
delta = SubResource("delta_b")

[resource]
script = ExtResource("1_scenario")
id = &"linh_02"
character = ExtResource("4_character")
title = "Online-Banking einrichten"
body_text = "Sie erledigen Ihre Überweisungen ja noch in der Filiale. Wenn Sie möchten, kann ich Ihnen zeigen, wie unser Online-Banking funktioniert. Dann müssten Sie für viele Dinge nicht mehr extra herkommen. Wollen Sie das ausprobieren?"
channel = 0
sender_label = ""
choice_a = SubResource("choice_a")
choice_b = SubResource("choice_b")
follows = &""
