[gd_resource type="Resource" script_class="ScenarioData" load_steps=9 format=3]

[ext_resource type="Script" path="res://src/resources/ScenarioData.gd" id="1_scenario"]
[ext_resource type="Script" path="res://src/resources/ChoiceData.gd" id="2_choice"]
[ext_resource type="Script" path="res://src/resources/ValueDelta.gd" id="3_delta"]
[ext_resource type="Resource" path="res://src/resources/data/characters/silke.tres" id="4_character"]

[sub_resource type="Resource" id="delta_a"]
script = ExtResource("3_delta")
selbststaendigkeit = 0
sicherheit = 1
verbundenheit = 0
entlastung = -1

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2_choice")
label = "Die Unterlagen ja, aber die Zugangsdaten würde ich getrennt schützen."
outcome_text = "Die wichtigen Dokumente sind gut auffindbar, während Passwörter und andere sensible Zugänge separat geschützt bleiben. Im Notfall braucht es deshalb einen klaren Plan, wie eine Vertrauensperson an die nötigen Zugänge kommt."
delta = SubResource("delta_a")

[sub_resource type="Resource" id="delta_b"]
script = ExtResource("3_delta")
selbststaendigkeit = 0
sicherheit = -1
verbundenheit = 0
entlastung = 1

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2_choice")
label = "Ja, dann ist wenigstens alles an einem Ort."
outcome_text = "Im Notfall wäre vieles schnell auffindbar. Gleichzeitig lägen sensible Dokumente und Zugangsdaten ungeschützt zusammen – wer die Mappe findet, hätte sehr viel auf einmal."
delta = SubResource("delta_b")

[resource]
script = ExtResource("1_scenario")
id = &"silke_07"
character = ExtResource("4_character")
title = "Alles in eine Mappe?"
body_text = "Ich hab mir gedacht, falls mal wirklich was ist, sollten wir deine wichtigen Unterlagen und Zugänge schnell finden. Wir könnten einfach alles in eine Mappe legen – Vollmachten, Verträge und auch die Passwörter. Dann weiß jeder sofort, wo er suchen muss. Was meinst du?"
channel = 0
sender_label = ""
choice_a = SubResource("choice_a")
choice_b = SubResource("choice_b")
follows = &""
