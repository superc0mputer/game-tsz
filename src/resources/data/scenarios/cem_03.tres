[gd_resource type="Resource" script_class="ScenarioData" load_steps=9 format=3]

[ext_resource type="Script" path="res://src/resources/ScenarioData.gd" id="1_scenario"]
[ext_resource type="Script" path="res://src/resources/ChoiceData.gd" id="2_choice"]
[ext_resource type="Script" path="res://src/resources/ValueDelta.gd" id="3_delta"]
[ext_resource type="Resource" path="res://src/resources/data/characters/cem.tres" id="4_character"]

[sub_resource type="Resource" id="delta_a"]
script = ExtResource("3_delta")
selbststaendigkeit = 0
sicherheit = -1
verbundenheit = 0
entlastung = 1

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2_choice")
label = "Ich lösche sie sofort."
outcome_text = "Die gefährliche Nachricht ist weg und du kannst nicht mehr versehentlich darauf tippen. Für eine Meldung oder spätere Nachfragen fehlen allerdings möglicherweise Informationen aus der Nachricht."
delta = SubResource("delta_a")

[sub_resource type="Resource" id="delta_b"]
script = ExtResource("3_delta")
selbststaendigkeit = 1
sicherheit = 1
verbundenheit = 0
entlastung = -1

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2_choice")
label = "Ich mache erst einen Screenshot und lösche sie danach."
outcome_text = "Du behältst die wichtigsten Informationen, ohne auf den Link zu gehen. Das kann hilfreich sein, wenn du den Vorgang melden oder später nachvollziehen möchtest. Falsche SMS im Namen von Banken, Behörden oder zu angeblichen Gerichtsverfahren kommen tatsächlich vor."
delta = SubResource("delta_b")

[resource]
script = ExtResource("1_scenario")
id = &"cem_03"
character = ExtResource("4_character")
title = "Was machen wir mit der Nachricht?"
body_text = "Sie haben die verdächtige SMS zum Glück nicht geöffnet. Darin wird mit einem Gerichtsverfahren gedroht und Sie sollen über einen Link sofort zahlen. Wollen Sie die Nachricht gleich löschen oder erst noch sichern?"
channel = 0
sender_label = ""
choice_a = SubResource("choice_a")
choice_b = SubResource("choice_b")
follows = &""
