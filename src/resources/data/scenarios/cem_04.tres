[gd_resource type="Resource" script_class="ScenarioData" load_steps=9 format=3]

[ext_resource type="Script" path="res://src/resources/ScenarioData.gd" id="1_scenario"]
[ext_resource type="Script" path="res://src/resources/ChoiceData.gd" id="2_choice"]
[ext_resource type="Script" path="res://src/resources/ValueDelta.gd" id="3_delta"]
[ext_resource type="Resource" path="res://src/resources/data/characters/cem.tres" id="4_character"]

[sub_resource type="Resource" id="delta_a"]
script = ExtResource("3_delta")
selbststaendigkeit = -1
sicherheit = 0
verbundenheit = 0
entlastung = 1

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2_choice")
label = "Dann lösche ich die Aufnahme lieber gleich."
outcome_text = "Die Aufnahme ist weg und die Situation mit der Frau ist schnell geklärt. Du weißt allerdings noch nicht genau, wie es überhaupt dazu gekommen ist – beim nächsten Mal könnte dir dasselbe wieder passieren."
delta = SubResource("delta_a")

[sub_resource type="Resource" id="delta_b"]
script = ExtResource("3_delta")
selbststaendigkeit = 1
sicherheit = 1
verbundenheit = 0
entlastung = -1

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2_choice")
label = "Ich möchte erst verstehen, wie ich die Aufnahme versehentlich gestartet habe."
outcome_text = "Cem hilft dir zunächst, die Aufnahme zu stoppen, und du schaust anschließend nach, wie Kamera, Leuchte und Aufnahmefunktion deiner Brille funktionieren. Das dauert etwas länger, hilft dir aber beim nächsten Mal."
delta = SubResource("delta_b")

[resource]
script = ExtResource("1_scenario")
id = &"cem_04"
character = ExtResource("4_character")
title = "Die Smart-Glasses"
body_text = "Sie haben die Smart Glasses wohl neu? Vorhin auf dem Marktplatz haben Sie damit eine Aufnahme gestartet. Eine Frau hat sich beschwert, weil sie dabei mitgefilmt wurde. Ihnen war gar nicht klar, dass die kleine Leuchte bedeutet, dass die Kamera läuft, oder?"
channel = 0
sender_label = ""
choice_a = SubResource("choice_a")
choice_b = SubResource("choice_b")
follows = &""
