[gd_resource type="Resource" script_class="ScenarioData" load_steps=9 format=3]

[ext_resource type="Script" path="res://src/resources/ScenarioData.gd" id="1_scenario"]
[ext_resource type="Script" path="res://src/resources/ChoiceData.gd" id="2_choice"]
[ext_resource type="Script" path="res://src/resources/ValueDelta.gd" id="3_delta"]
[ext_resource type="Resource" path="res://src/resources/data/characters/cem.tres" id="4_character"]

[sub_resource type="Resource" id="delta_a"]
script = ExtResource("3_delta")
selbststaendigkeit = 1
sicherheit = 1
verbundenheit = 0
entlastung = 0

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2_choice")
label = "Ich habe die Person blockiert, die Nachricht aber behalten."
outcome_text = "Die Person kann dich nicht mehr direkt anschreiben und die Nachricht bleibt als Nachweis erhalten. Falls du den Vorfall melden möchtest, kannst du zeigen, was geschrieben wurde und von welchem Account es kam."
delta = SubResource("delta_a")

[sub_resource type="Resource" id="delta_b"]
script = ExtResource("3_delta")
selbststaendigkeit = 0
sicherheit = -1
verbundenheit = 0
entlastung = 1

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2_choice")
label = "Ich habe die Nachricht sofort gelöscht."
outcome_text = "Die Nachricht ist weg und du musst sie nicht mehr sehen. Für eine spätere Meldung fehlt dir dadurch aber möglicherweise ein wichtiger Nachweis."
delta = SubResource("delta_b")

[resource]
script = ExtResource("1_scenario")
id = &"cem_05"
character = ExtResource("4_character")
title = "Die Nachricht in der Nachbarschaftsgruppe"
body_text = "Sie haben also eine Nachricht in Ihrer Facebook-Nachbarschaftsgruppe bekommen, in der Sie konkret bedroht wurden? Das ist ziemlich heftig. Wenn so eine Nachricht kommt, will man sie am liebsten sofort loswerden. Haben Sie schon etwas unternommen, bevor Sie zu mir gekommen sind?"
channel = 0
sender_label = ""
choice_a = SubResource("choice_a")
choice_b = SubResource("choice_b")
follows = &""
