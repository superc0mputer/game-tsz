[ext_resource type="Script" path="res://src/resources/ValueDelta.gd" id="3_delta"]
[ext_resource type="Resource" path="res://src/resources/data/characters/michael.tres" id="4_character"]

[sub_resource type="Resource" id="delta_a"]
script = ExtResource("3_delta")
selbststaendigkeit = 0
sicherheit = 0
verbundenheit = 1
entlastung = 1

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2_choice")
label = "Ich frage erst bei den Nachbarn nach."
outcome_text = "Das Paket liegt tatsächlich zwei Häuser weiter und du bekommst es noch am selben Tag."
delta = SubResource("delta_a")

[sub_resource type="Resource" id="delta_b"]
script = ExtResource("3_delta")
selbststaendigkeit = 0
sicherheit = 1
verbundenheit = 0
entlastung = -1

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2_choice")
label = "Dann melde ich sofort, dass es verschwunden ist."
outcome_text = "Kurz darauf stellt sich heraus, dass ein Nachbar das Paket angenommen hat."
delta = SubResource("delta_b")

[resource]
script = ExtResource("1_scenario")
id = &"michael_01"
character = ExtResource("4_character")
title = "Paket angeblich zugestellt"
body_text = "Bei mir im System steht, dass Ihr Paket gestern zugestellt wurde. Sie haben aber nichts bekommen?"
channel = 0
