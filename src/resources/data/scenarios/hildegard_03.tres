[resource]
script = ExtResource("1_scenario")
id = &"hildegard_03"
character = ExtResource("4_character")
title = "Aufzug kaputt"
body_text = "Wir müssen ja am Hauptbahnhof umsteigen, damit wir rechtzeitig beim Theater sind. Jetzt zeigt dein Handy, dass der Aufzug dort kaputt ist. Mit meinen Knien die Treppen hoch muss ich echt nicht haben. Was meinst du?"
