[gd_resource type="Resource" script_class="ScenarioData" load_steps=9 format=3]

[ext_resource type="Script" path="res://src/resources/ScenarioData.gd" id="1_scenario"]
[ext_resource type="Script" path="res://src/resources/ChoiceData.gd" id="2_choice"]
[ext_resource type="Script" path="res://src/resources/ValueDelta.gd" id="3_delta"]
[ext_resource type="Resource" path="res://src/resources/data/characters/gerhard.tres" id="4_character"]

[sub_resource type="Resource" id="delta_a"]
script = ExtResource("3_delta")
selbststaendigkeit = 0
sicherheit = 1
verbundenheit = 0
entlastung = -1

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2_choice")
label = "Schau dir den Shop und den Preis lieber erst genauer an."
outcome_text = "Gerhard vergleicht den Preis, prüft den Anbieter und findet mehrere Warnzeichen: ungewöhnlich günstiger Preis, künstlicher Zeitdruck und kaum verlässliche Informationen zum Shop. Er lässt das Angebot aus."
delta = SubResource("delta_a")

[sub_resource type="Resource" id="delta_b"]
script = ExtResource("3_delta")
selbststaendigkeit = 0
sicherheit = -2
verbundenheit = 0
entlastung = 0

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2_choice")
label = "Wenn du sie sowieso willst, bestell lieber gleich."
outcome_text = "Gerhard bestellt unter Zeitdruck. Später stellt sich heraus, dass der Shop nicht seriös war. Der extrem niedrige Preis und der Countdown waren Warnzeichen, die zum schnellen Kauf drängen sollten."
delta = SubResource("delta_b")

[resource]
script = ExtResource("1_scenario")
id = &"gerhard_03"
character = ExtResource("4_character")
title = "Das Schnäppchen"
body_text = "Schau mal, ich hab online eine Küchenmaschine gefunden, die sonst fast 500 Euro kostet. Hier gibt’s die für 179 Euro. Aber das Angebot läuft angeblich nur noch zehn Minuten. Eigentlich wär das schon ein super Preis. Was meinst du?"
channel = 0
sender_label = ""
choice_a = SubResource("choice_a")
choice_b = SubResource("choice_b")
follows = &""
