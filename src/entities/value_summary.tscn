[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/entities/value_summary.gd" id="1_summary"]
[ext_resource type="Script" path="res://src/components/SegmentBar.gd" id="2_segbar"]

[node name="ValueSummary" type="PanelContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3
theme_type_variation = &"SoftPanel"
script = ExtResource("1_summary")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 14

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Icon" type="TextureRect" parent="Margin/Column/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(32, 32)
layout_mode = 2
size_flags_vertical = 4
expand_mode = 1
stretch_mode = 5

[node name="NameLabel" type="Label" parent="Margin/Column/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SubtitleLabel"
text = "Wert"

[node name="ScoreLabel" type="Label" parent="Margin/Column/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BarValue"
text = "5 / 10"

[node name="Bar" type="Control" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 16)
layout_mode = 2
script = ExtResource("2_segbar")

[node name="StateLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StateLabel"
text = "Zustand"

[node name="DescriptionLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"SmallText"
text = "Beschreibung"
autowrap_mode = 3
