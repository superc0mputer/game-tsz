[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/entities/scenario_bubble.gd" id="1_bubble"]

[node name="ScenarioBubble" type="PanelContainer"]
theme_type_variation = &"BubblePanel"
script = ExtResource("1_bubble")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 12

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Header" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Margin/Column/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SubtitleLabel"
text = "Titel"
text_overrun_behavior = 3

[node name="SenderLabel" type="Label" parent="Margin/Column/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Muted"
text = "Jemand sagt:"

[node name="BodyLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BubbleBody"
text = "Text"
autowrap_mode = 3
